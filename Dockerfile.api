# Build stage: needs the dev dependencies (TypeScript) to compile src/ to dist/.
FROM node:20-alpine AS build
WORKDIR /app
COPY api/package.json api/yarn.lock ./
RUN yarn install --frozen-lockfile --network-timeout 300000
COPY api/tsconfig.json ./
COPY api/src ./src
RUN yarn build

FROM node:20-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY api/package.json api/yarn.lock ./
RUN yarn install --production --frozen-lockfile --network-timeout 300000 && yarn cache clean
COPY --from=build /app/dist ./dist
# Built Vue app. Run `yarn build-frontend` before `docker compose up --build`.
COPY api/public ./public
USER node
EXPOSE 8080
CMD ["node", "dist/index.js"]

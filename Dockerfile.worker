# Same Playwright version as worker/package.json, so the bundled Chromium matches.
FROM mcr.microsoft.com/playwright:v1.47.0-jammy AS build
WORKDIR /app
COPY worker/package.json worker/yarn.lock ./
RUN npx --yes yarn@1.22.22 install --frozen-lockfile --network-timeout 300000
COPY worker/tsconfig.json ./
COPY worker/src ./src
RUN npx --yes yarn@1.22.22 build

FROM mcr.microsoft.com/playwright:v1.47.0-jammy
ENV NODE_ENV=production
WORKDIR /app
COPY worker/package.json worker/yarn.lock ./
RUN npx --yes yarn@1.22.22 install --production --frozen-lockfile --network-timeout 300000 && npx --yes yarn@1.22.22 cache clean
COPY --from=build /app/dist ./dist
USER pwuser
CMD ["node", "dist/index.js"]
